# Local learning logs (per-developer; see self-improvement skill)
.learnings/

# Environment / secrets - do not commit
.env
*.log

# Python virtual env / build artifacts
.venv/
__pycache__/
*.egg-info/

# Tooling / editor artifacts
.envsitter/
.idea/
.opencode/

# Agent scratch / draft artifacts (architecture diagrams, visual checks)
.scratch/

# RAG runtime storage (graphml, kv_store_*, vdb_*) — generated by running the pipeline
lightrag/rag_storage/

# Parsed PDF products (outputs of the parser; large, regenerable)
lightrag/inputs/__parsed__/

# Frontend build product served by the backend (regenerable via `bun run build`)
lightrag/lightrag/api/webui/

# Frontend lockfile (bun.lock is the source of truth)
package-lock.json
pnpm-lock.yaml
yarn.lock

# Frontend (lightrag_webui) — merged from lightrag_webui/.gitignore
logs/
node_modules
dist
dist-ssr
*.local
.vscode/*
!.vscode/extensions.json
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
